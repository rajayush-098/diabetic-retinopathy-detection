# Keep the final selected model
!models/mobilenetv2_independent_finetuned_best.keras

# Checkpoints and logs
models/checkpoints/
logs/
*.log

# Generated outputs
outputs/*

# Keep selected visual results
!outputs/gradcam/
!outputs/screenshots/

# Secrets
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE files
.vscode/
.idea/