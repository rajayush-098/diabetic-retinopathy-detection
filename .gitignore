# Python environments
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]

# Jupyter
.ipynb_checkpoints/

# Dataset: exclude images, CSVs and generated splits
dataset/train_images/
dataset/independent_splits/
dataset/*.csv

# Model files: exclude experimental models
models/*.keras
models/*.h5
